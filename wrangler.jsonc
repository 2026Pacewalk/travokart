{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travokart",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travokart-db",
      "database_id": "b5135beb-2418-4036-acb6-e02236540cc8"
    }
  ]
}
